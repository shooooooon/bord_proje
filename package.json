{
  "name": "slack-learning-app",
  "version": "1.0.0",
  "description": "Interactive Slack learning application prototype",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
